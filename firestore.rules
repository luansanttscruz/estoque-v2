rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers
    function isAuthenticated() {
      return request.auth != null;
    }

    function domainAllowed() {
      return isAuthenticated()
        && request.auth.token.email != null
        && request.auth.token.email.matches('(?i)[^@]+@vtex\\.com$');
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return domainAllowed() && userDoc().data.role == "admin";
    }

    function hasPermissions() {
      return "permissions" in userDoc().data;
    }

    function canEditInventory() {
      return domainAllowed()
        && (
          isAdmin()
          || (hasPermissions() && userDoc().data.permissions.inventory == "edit")
          || (!hasPermissions() && userDoc().data.access == "edit")
        );
    }

    function canEditMovement() {
      return domainAllowed()
        && (
          isAdmin()
          || (hasPermissions() && userDoc().data.permissions.movement == "edit")
          || (!hasPermissions() && userDoc().data.access == "edit")
        );
    }

    function canEditStock() {
      return canEditInventory() || canEditMovement();
    }

    function canEditPeripherals() {
      return domainAllowed()
        && (
          isAdmin()
          || (hasPermissions() && userDoc().data.permissions.peripherals == "edit")
          || (!hasPermissions() && userDoc().data.access == "edit")
        );
    }

    function canEditWeeklyTasks() {
      return domainAllowed()
        && (
          isAdmin()
          || (hasPermissions() && userDoc().data.permissions.weeklyTasks == "edit")
          || (!hasPermissions() && userDoc().data.access == "edit")
        );
    }

    function canEditLicenses() {
      return domainAllowed()
        && (
          isAdmin()
          || (hasPermissions() && userDoc().data.permissions.licenses == "edit")
          || (!hasPermissions() && userDoc().data.access == "edit")
        );
    }

    function canEditTerms() {
      return domainAllowed()
        && (
          isAdmin()
          || (hasPermissions() && userDoc().data.permissions.terms == "edit")
          || (hasPermissions() && !("terms" in userDoc().data.permissions) && userDoc().data.access == "edit")
          || (!hasPermissions() && userDoc().data.access == "edit")
        );
    }

    function isAdminEmail() {
      return domainAllowed() && request.auth.token.email == "luan.cruz@vtex.com";
    }

    // Usuários (admin/padrão)
    match /users/{userId} {
      allow read: if domainAllowed();
      allow create: if domainAllowed()
        && request.auth.uid == userId
        && (request.resource.data.role in ["admin", "padrao"])
        && (request.resource.data.access in ["edit", "view"])
        && (!("permissions" in request.resource.data) || request.resource.data.permissions is map)
        && (request.resource.data.role != "admin" || isAdminEmail());
      allow update: if domainAllowed()
        && (
          isAdmin() ||
          isAdminEmail() ||
          (request.auth.uid == userId
            && request.resource.data.role == resource.data.role
            && (
              request.resource.data.access == resource.data.access ||
              (!("access" in resource.data) && request.resource.data.access == "edit")
            )
            && (
              request.resource.data.permissions == resource.data.permissions ||
              !("permissions" in resource.data)
            )
          )
        );
      allow delete: if isAdmin();
    }

    // Preferências do usuário
    match /userPreferences/{uid} {
      allow read: if domainAllowed();
      allow create, update: if domainAllowed() && request.auth.uid == uid;
      allow delete: if false;
    }

    // Licenças por máquina
    match /licenses-machines/{serial} {
      allow read: if domainAllowed();
      allow create: if canEditLicenses()
        && request.resource.id == request.resource.data.serial
        && request.resource.data.serial is string
        && request.resource.data.machine is string
        && request.resource.data.recoveryKey is string
        && request.resource.data.createdAt is timestamp;
      allow update: if canEditLicenses()
        && request.resource.id == resource.data.serial
        && request.resource.data.serial == resource.data.serial
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.machine is string
        && request.resource.data.recoveryKey is string;
      allow delete: if canEditLicenses();
    }

    // Movimentações de equipamento
    match /equipment-movements/{docId} {
      allow read: if domainAllowed();
      allow create: if canEditMovement() && movementIsValid();
      allow update: if canEditMovement() && movementIsValid()
        && resource.data.criadoEm == request.resource.data.criadoEm;
      allow delete: if canEditMovement();

      function movementIsValid() {
        return
          (request.resource.data.tipo in ['Saida','Entrada']) &&
          (request.resource.data.status in ['Pendente','Finalizado']) &&
          (request.resource.data.disponibilidade in ['Disponível','Indisponível']) &&
          (request.resource.data.data is string) &&
          (request.resource.data.modelo is string) &&
          (request.resource.data.numeroSerie is string) &&
          (request.resource.data.responsavel is string) &&
          (request.resource.data.local is string) &&
          (!('localDescricao' in request.resource.data) || request.resource.data.localDescricao is string) &&
          (request.resource.data.criadoEm is timestamp) &&
          (!('obs' in request.resource.data) || request.resource.data.obs is string) &&
          (!('email' in request.resource.data) || request.resource.data.email is string) &&
          (!('fotoUrl' in request.resource.data) || request.resource.data.fotoUrl is string) &&
          (!('fotoDriveLink' in request.resource.data) || request.resource.data.fotoDriveLink is string);
      }
    }

    // Auditoria: leitura restrita a admins e escrita automática pelo app.
    match /audit-logs/{logId} {
      allow read: if isAdmin();
      allow create: if domainAllowed()
        && request.resource.data.createdAt is timestamp
        && request.resource.data.module is string
        && request.resource.data.entityType is string
        && request.resource.data.entityId is string
        && request.resource.data.action is string
        && request.resource.data.actor is map
        && request.resource.data.actor.uid == request.auth.uid
        && request.resource.data.actor.email == request.auth.token.email
        && request.resource.data.changedFields is list;
      allow update, delete: if false;
    }

    // Weekly Tasks (coleção atual usada no app)
    match /weekly-tasks/{taskId} {
      allow read: if domainAllowed();
      allow create, update, delete: if canEditWeeklyTasks();
    }

    // WEEKLY TASKS por usuário: weeklytasks-<uid>
    match /weeklytasks-users/{uid}/tasks/{taskId} {
      allow read: if domainAllowed() && request.auth.uid == uid;
      allow write: if canEditWeeklyTasks() && request.auth.uid == uid;
    }

    // Estoque por escritório
    match /{officeId}/{serialId} {
      allow read: if domainAllowed()
        && officeId in ['sao-paulo','rio-de-janeiro','joao-pessoa','outros'];
      allow create: if canEditStock()
        && officeId in ['sao-paulo','rio-de-janeiro','joao-pessoa','outros']
        && stockValid()
        && request.resource.id == request.resource.data.serial;
      allow update: if canEditStock()
        && officeId in ['sao-paulo','rio-de-janeiro','joao-pessoa','outros']
        && stockValid()
        && request.resource.id == resource.data.serial
        && request.resource.data.serial == resource.data.serial
        && resource.data.createdAt == request.resource.data.createdAt;
      allow delete: if canEditStock()
        && officeId in ['sao-paulo','rio-de-janeiro','joao-pessoa','outros'];

      function stockValid() {
        return
          (request.resource.data.serial is string) &&
          (request.resource.data.modelo is string) &&
          (request.resource.data.status in ['Disponivel','Indisponivel','Disponível','Indisponível']) &&
          (request.resource.data.createdAt is timestamp) &&
          (request.resource.data.updatedAt is timestamp) &&
          (!('email' in request.resource.data) || request.resource.data.email is string) &&
          (!('observacao' in request.resource.data) || request.resource.data.observacao is string) &&
          (!('fotoUrl' in request.resource.data) || request.resource.data.fotoUrl is string) &&
          (!('fotoDriveLink' in request.resource.data) || request.resource.data.fotoDriveLink is string);
      }
    }

    // Configurações globais
    match /appSettings/{docId} {
      allow read: if domainAllowed();
      allow update: if isAdmin() && docId == 'global';
      allow create, delete: if false;
    }

    // Funcionários (somente leitura)
    match /employees/{uid} {
      allow read: if domainAllowed();
      allow write: if false;
    }

    // Periféricos
    match /peripherals/{docId} {
      allow read: if domainAllowed();
      allow create, update, delete: if canEditPeripherals();
    }

    // Termos de envio e assinatura
    match /terms/{docId} {
      allow read: if domainAllowed();
      allow create, update: if canEditTerms() && termValid();
      allow delete: if false;

      function termValid() {
        return
          (request.resource.data.nome is string) &&
          (request.resource.data.email is string) &&
          (request.resource.data.dataEnvio is string) &&
          (request.resource.data.dataAssinatura is string) &&
          (request.resource.data.status in ['Em andamento','Pendente','Concluído','Cancelado']) &&
          (request.resource.data.slaDias is string) &&
          (request.resource.data.mes is string) &&
          (request.resource.data.createdAt is timestamp) &&
          (request.resource.data.updatedAt is timestamp) &&
          (!('historico' in request.resource.data) || request.resource.data.historico is list);
      }
    }

    // Bloqueio padrão — deixe sempre por último
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
